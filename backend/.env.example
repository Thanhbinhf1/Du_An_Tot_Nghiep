PORT=5000
DATABASE_URL=your_mongo_url
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_unique_password_at_least_12_characters

# Thanh toán chuyển khoản do quản trị viên xác nhận
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# SePay QR theo đơn hàng, ngân hàng đã liên kết trên my.sepay.vn
# Mã ngân hàng đúng tên SePay trả về, ví dụ MBBank, Vietcombank, ACB
# Với VietinBank, mã QR và nội dung hiển thị tự thêm tiền tố SEVQR
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Webhook: https://<backend-domain>/api/payments/sepay/webhook
# Chọn API Key và application/json, dùng cùng khóa dưới đây
# Chọn sự kiện Có tiền vào, bật gửi lại khi server trả lỗi
# Cấu hình tiền tố mã thanh toán FS, theo sau là 12 chữ số
SEPAY_WEBHOOK_API_KEY=
# API Access -> tạo token để kiểm tra giao dịch khi chạy localhost
# Có thể dùng API Token trước khi có URL webhook công khai
SEPAY_API_TOKEN=
# production cho tài khoản thật, sandbox cho tài khoản Test Mode
SEPAY_ENV=production

# VNPay sandbox (chỉ dùng cho đơn VNPay đã tạo trước đó)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=
VNP_RESULT_PAGE_URL=http://localhost:3000/payment/result
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_RESULT_PAGE_URL=http://localhost:3000/payment/result
