PORT=5000
DATABASE_URL=your_mongo_url
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_unique_password_at_least_12_characters

# Email gửi mã khôi phục mật khẩu (Gmail dùng mật khẩu ứng dụng)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Có thể dùng dạng "Tên cửa hàng <email-gửi>"; mặc định VSC_BAPD <SMTP_USER>
SMTP_FROM=

# Thanh toán chuyển khoản do quản trị viên xác nhận
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# SePay VietQR và webhook xác nhận chuyển khoản
# Mã ngân hàng đúng tên SePay trả về, ví dụ MBBank, Vietcombank, ACB
# Với VietinBank, mã QR và nội dung hiển thị tự thêm tiền tố SEVQR
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Webhook: https://<backend-domain>/api/payments/sepay/webhook
# Chọn API Key và application/json, dùng cùng khóa dưới đây
# Chọn sự kiện Có tiền vào, bật gửi lại khi server trả lỗi
# Cấu hình cấu trúc mã thanh toán FS + 12 chữ số trên SePay.
# Để bộ lọc mã thanh toán của webhook tắt để giao dịch lỗi mã vẫn được đối soát.
SEPAY_WEBHOOK_API_KEY=
# API Access -> tạo token để kiểm tra giao dịch khi chạy localhost
# Có thể dùng API Token trước khi có URL webhook công khai
SEPAY_API_TOKEN=
# production cho tài khoản thật, sandbox cho tài khoản Test Mode
SEPAY_ENV=production

# VNPay sandbox (chỉ dùng cho đơn VNPay đã tạo trước đó)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=
VNP_RESULT_PAGE_URL=http://localhost:3000/payment/result
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo API: bật sau khi đã điền bộ mã tích hợp của chính cửa hàng.
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_RESULT_PAGE_URL=http://localhost:3000/payment/result


# Khi MoMo duyệt Production, thay cả bộ mã bằng thông tin Production của shop.
# MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
# MOMO_REDIRECT_URL=https://API_DOMAIN/api/payments/momo/return
# MOMO_IPN_URL=https://API_DOMAIN/api/payments/momo/ipn
# MOMO_RESULT_PAGE_URL=https://SHOP_DOMAIN/payment/result
# Frontend: NEXT_PUBLIC_MOMO_PAYMENT_HOST=payment.momo.vn rồi build lại.
