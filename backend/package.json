{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check:source": "node scripts/check-source-artifacts.mjs",
    "dev": "npm run check:source && tsx watch src/server.ts",
    "build": "npm run check:source && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run check:source && tsx --test tests/*.test.ts",
    "test:mongodb": "tsx --test tests/mongodbTransaction.integration.ts",
    "test:integration": "tsx --test tests/productVariants.integration.ts",
    "start": "node dist/server.js",
    "create-admin": "npm run check:source && tsx src/scripts/createAdmin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
